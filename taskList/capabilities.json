{
    "dataRoles": [
        {
            "displayName": "Project",
            "displayNameKey": "Role_Task",
            "name": "task",
            "kind": "Grouping",
            "description": "Task or project name (required).",
            "descriptionKey": "Role_Task_Desc",
            "preferredTypes": [
                {
                    "text": true
                }
            ]
        },
        {
            "displayName": "RAG",
            "displayNameKey": "Role_Status",
            "name": "status",
            "kind": "Grouping",
            "description": "Project status or RAG (Red / Amber / Green).",
            "descriptionKey": "Role_Status_Desc",
            "preferredTypes": [
                {
                    "text": true
                }
            ]
        },
        {
            "displayName": "Group",
            "displayNameKey": "Role_Group",
            "name": "group",
            "kind": "Grouping",
            "description": "Phase / parent for section headers or a column.",
            "descriptionKey": "Role_Group_Desc",
            "preferredTypes": [
                {
                    "text": true
                }
            ]
        },
        {
            "displayName": "Project lead",
            "displayNameKey": "Role_Resource",
            "name": "resource",
            "kind": "Grouping",
            "description": "Assignee or project lead.",
            "descriptionKey": "Role_Resource_Desc",
            "preferredTypes": [
                {
                    "text": true
                }
            ]
        },
        {
            "displayName": "Progress",
            "displayNameKey": "Role_Progress",
            "name": "progress",
            "kind": "Measure",
            "description": "Progress as 0–1 or 0–100.",
            "descriptionKey": "Role_Progress_Desc",
            "requiredTypes": [
                {
                    "numeric": true
                },
                {
                    "integer": true
                }
            ]
        },
        {
            "displayName": "Start Date",
            "displayNameKey": "Role_StartDate",
            "name": "startDate",
            "kind": "GroupingOrMeasure",
            "description": "Optional start date column.",
            "descriptionKey": "Role_StartDate_Desc"
        },
        {
            "displayName": "End Date",
            "displayNameKey": "Role_EndDate",
            "name": "endDate",
            "kind": "GroupingOrMeasure",
            "description": "Optional end date. Duration can substitute.",
            "descriptionKey": "Role_EndDate_Desc"
        },
        {
            "displayName": "Duration",
            "displayNameKey": "Role_Duration",
            "name": "duration",
            "kind": "Measure",
            "description": "Duration in days. Used when End Date is absent.",
            "descriptionKey": "Role_Duration_Desc",
            "requiredTypes": [
                {
                    "numeric": true
                },
                {
                    "integer": true
                }
            ]
        },
        {
            "displayName": "Tooltips",
            "displayNameKey": "Role_Tooltips",
            "name": "tooltipFields",
            "kind": "Grouping",
            "description": "Extra fields shown in tooltips.",
            "descriptionKey": "Role_Tooltips_Desc"
        }
    ],
    "objects": {
        "general": {
            "displayName": "General",
            "displayNameKey": "Objects_General",
            "properties": {
                "density": {
                    "displayName": "Density",
                    "displayNameKey": "Prop_Density",
                    "description": "Suite size preset. Custom uses Labels / rows values.",
                    "type": {
                        "enumeration": [
                            {
                                "displayName": "Compact",
                                "value": "compact"
                            },
                            {
                                "displayName": "Comfortable",
                                "value": "comfortable"
                            },
                            {
                                "displayName": "Large",
                                "value": "large"
                            },
                            {
                                "displayName": "Custom",
                                "value": "custom"
                            }
                        ]
                    }
                },
                "sortOrder": {
                    "displayName": "Sort order",
                    "displayNameKey": "Prop_SortOrder",
                    "type": {
                        "enumeration": [
                            {
                                "displayName": "Group then name",
                                "value": "groupName"
                            },
                            {
                                "displayName": "Status (RAG)",
                                "value": "status"
                            },
                            {
                                "displayName": "End date",
                                "value": "endDate"
                            },
                            {
                                "displayName": "Name",
                                "value": "name"
                            }
                        ]
                    }
                },
                "showGroupHeaders": {
                    "displayName": "Show group headers",
                    "displayNameKey": "Prop_ShowGroupHeaders",
                    "type": {
                        "bool": true
                    }
                },
                "alternateRowShading": {
                    "displayName": "Alternate row shading",
                    "displayNameKey": "Prop_AlternateRowShading",
                    "type": {
                        "bool": true
                    }
                }
            }
        },
        "status": {
            "displayName": "Status",
            "displayNameKey": "Objects_Status",
            "properties": {
                "redColor": {
                    "displayName": "Red",
                    "displayNameKey": "Prop_StatusRed",
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "amberColor": {
                    "displayName": "Amber",
                    "displayNameKey": "Prop_StatusAmber",
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "greenColor": {
                    "displayName": "Green",
                    "displayNameKey": "Prop_StatusGreen",
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                }
            }
        },
        "progress": {
            "displayName": "Progress",
            "displayNameKey": "Objects_Progress",
            "properties": {
                "trackColor": {
                    "displayName": "Track",
                    "displayNameKey": "Prop_ProgressTrack",
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "fillColor": {
                    "displayName": "Fill",
                    "displayNameKey": "Prop_ProgressFill",
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "showPercent": {
                    "displayName": "Show percent label",
                    "displayNameKey": "Prop_ShowPercent",
                    "type": {
                        "bool": true
                    }
                }
            }
        },
        "labels": {
            "displayName": "Labels / rows",
            "displayNameKey": "Objects_Labels",
            "properties": {
                "fontSize": {
                    "displayName": "Font size",
                    "displayNameKey": "Prop_FontSize",
                    "type": {
                        "formatting": {
                            "fontSize": true
                        }
                    }
                },
                "fontFamily": {
                    "displayName": "Font family",
                    "displayNameKey": "Prop_FontFamily",
                    "type": {
                        "formatting": {
                            "fontFamily": true
                        }
                    }
                },
                "rowPadding": {
                    "displayName": "Row padding",
                    "displayNameKey": "Prop_RowPadding",
                    "type": {
                        "numeric": true
                    }
                },
                "cornerRadius": {
                    "displayName": "Corner radius",
                    "displayNameKey": "Prop_CornerRadius",
                    "type": {
                        "numeric": true
                    }
                }
            }
        }
    },
    "dataViewMappings": [
        {
            "conditions": [
                {
                    "task": { "min": 1, "max": 1 },
                    "status": { "max": 1 },
                    "group": { "max": 1 },
                    "resource": { "max": 1 },
                    "progress": { "max": 1 },
                    "startDate": { "max": 1 },
                    "endDate": { "max": 1 },
                    "duration": { "max": 1 },
                    "tooltipFields": { "max": 8 }
                }
            ],
            "table": {
                "rows": {
                    "select": [
                        { "for": { "in": "task" } },
                        { "for": { "in": "status" } },
                        { "for": { "in": "group" } },
                        { "for": { "in": "resource" } },
                        { "bind": { "to": "progress" } },
                        { "for": { "in": "startDate" } },
                        { "for": { "in": "endDate" } },
                        { "bind": { "to": "duration" } },
                        { "for": { "in": "tooltipFields" } }
                    ],
                    "dataReductionAlgorithm": {
                        "top": {
                            "count": 30000
                        }
                    }
                }
            }
        }
    ],
    "privileges": [],
    "supportsHighlight": true,
    "supportsMultiVisualSelection": true,
    "supportsLandingPage": true,
    "supportsEmptyDataView": true,
    "supportsKeyboardFocus": true,
    "tooltips": {
        "supportedTypes": {
            "default": true,
            "canvas": true
        },
        "roles": [
            "tooltipFields"
        ]
    }
}
